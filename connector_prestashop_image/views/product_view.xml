<odoo>

    <record id="view_product_template_img_mode" model="ir.ui.view">
        <field name="name">Add images mode</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="product_multi_image.view_product_template_form_img_inh"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_ids']" position="attributes">
				<attribute name="context">{
                               'default_owner_model': 'product.template',
                               'default_owner_id': id,
                               'form_view_ref': 'product_multi_image.image_form_view',
                               'kanban_view_ref': 'product_multi_image.image_kanban_view',
                               'list_view_ref': 'connector_prestashop.image_tree_view'
                           }</attribute>
                <attribute name="mode">list</attribute>
            </xpath>

        </field>
    </record>


</odoo>
