<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_prestashop_backend_form" model="ir.ui.view">
        <field name="name">prestashop.backend.form</field>
        <field name="model">prestashop.backend</field>
        <field name="inherit_id"
               ref="connector_prestashop.view_prestashop_backend_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='import_carriers']" position="after">
                <group name="import_manufacturers">
                    <span class="o_form_label o_td_label" name="import_manufacturers_since">
                        <b>Import manufacturers since</b>
                    </span>
                    <div>
                        <button name="import_manufacturers"
                                type="object"
                                class="oe_highlight oe_right"
                                string="Import in background"/>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
