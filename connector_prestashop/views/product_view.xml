<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_normal_form_view_default_check" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field invisible="product_variant_count &lt;= 1" name="default_on"/>
                <field
                        invisible="product_variant_count &lt;= 1"
                        name="impact_price"
                />
            </field>
            <xpath expr="//field[@name='lst_price']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_variant_easy_edit_view_check" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field invisible="product_variant_count &lt;= 1" name="default_on"/>
            </field>
            <xpath expr="//field[@name='lst_price']" position="after">
                <field invisible="product_variant_count &lt;= 1" name="impact_price"/>
            </xpath>
            <xpath expr="//field[@name='lst_price']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_prestashop_view" model="ir.ui.view">
        <field name="name">product.product.prestashop.list</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="lst_price" position="after">
                <field name="default_on"/>
            </field>
            <field name="lst_price" position="after">
                <field name="impact_price"/>
            </field>
        </field>
    </record>

    <!--This is a product inherited form that will be dynamically populated -->
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page name="prestashop" string="Prestashop">
                    <div invisible="product_variant_count &lt;= 1">
                    <p>
                            To show Template binding go to:
                        <button name="open_product_template" type="object"
                                string="Product Template" class="oe_link"/>
                    </p>
                </div>
                    <field name="prestashop_combinations_bind_ids"/>
            </page>
            </xpath>
        </field>
    </record>


