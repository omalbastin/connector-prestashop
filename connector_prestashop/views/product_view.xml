            </field>
        </field>
    </record>
    <record id="product_template_common_form" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page name="prestashop" string="Prestashop">
                    <group string="PrestaShop Bindings">
                    <group>

                        <field name="ps_default_code"/>
                        <field name="ps_type"/>
                    </group>
                    <group>
                    </group>
                </group>
				<group string="Bindings" name="binding">
                    <field name="prestashop_bind_ids" nolabel="1"
                           context="{'default_reference':ps_default_code,'default_ps_name':name,'default_odoo_id':id}"/>
				</group>
            </page>
            </xpath>
        </field>
    </record>

