    <record id="product_connector_presta_form_view" model="ir.ui.view">
        <field name="model">prestashop.product.template</field>
        <field name="arch" type="xml">
            <form string="prestashop fields">
                <header>
                    <button name="resync" type="object" string="Re-Import"/>
                    <button name="re_export" type="object" string="Re-Export to PS"/>
                    <button
                            class="oe_highlight"
                            name="manually_recompute_prestashop_qty"
                            string="Export quantity"
                            type="object"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ps_name" required="1"/>
                            <field name="link_rewrite"/>
                            <field name="backend_id" readonly="1"/>
                            <field name="default_shop_id" readonly="1" domain="[('backend_id','=',backend_id)]"/>
                            <field name="reference" string="Reference" readonly="0"/>
                            <field name="quantity" string="Quantity" readonly="1"/>
                        </group>
                        <group>
                            <field name="upc"/>
                            <field name="prestashop_id" readonly="0"/>
                            <field name="odoo_id" invisible="0"/>
                            <field name="ps_active"/>
                            <field name="ps_active_date"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Description" name="basic">
                            <group string="Short Description">
                                <field name="description_short_html" nolabel="1"/>
                            </group>
                            <group string="Description">
                                <field name="description_html" nolabel="1"/>
                            </group>
                        </page>
                        <page name="other" string="Other Information">
                            <group>
                                <group>
                                    <field name="ps_active_date"/>
                                    <!--								<field name="always_available" />-->
                                    <field name="available_for_order"/>
                                    <field name="on_sale"/>
                                </group>
                                <group>
                                    <field name="date_upd"/>
                                    <field name="sale_ok"/>
                                    <field name="show_price"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <record id="product_connector_presta_tree_view" model="ir.ui.view">
        <field name="model">prestashop.product.template</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="backend_id" string="Backend"/>
                <field name="odoo_id" optional="hide"/>
                <field name="ps_active_date" optional="hide"/>
                <!-- 				<field name="prestashop_default_category_id" string="Category" /> -->
                <field name="prestashop_id"/>
                <field name="ps_name"/>
                <field name="link_rewrite"/>
                <field name="upc"/>
                <field name="reference" string="Reference"/>
                <field name="date_upd" column_invisible="1"/>
                <field name="quantity"/>
                <button name="manually_recompute_prestashop_qty" class="oe_highlight"
                        type="object" string="Export quantity"/>
                <button name="resync" type="object" string="Re-Import"/>
                <button name="re_export" type="object" string="Re-Export"/>
            </list>
        </field>
    </record>

    <record id="combination_connector_presta_form_view" model="ir.ui.view">
        <field name="model">prestashop.product.product</field>
        <field name="arch" type="xml">
            <form string="prestashop fields">
                <header>
                    <button name="resync" type="object" string="Re-Import"/>
                    <button name="re_export" type="object" string="Re-Export to PS"/>
                    <button
                            class="oe_highlight"
                            name="manually_recompute_prestashop_qty"
                            string="Export quantity"
                            type="object"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="main_template_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="backend_id"/>
                            <field name="prestashop_id"/>
                            <field name="odoo_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="combination_connector_presta_tree_view" model="ir.ui.view">
        <field name="model">prestashop.product.product</field>
        <field name="arch" type="xml">
            <list string="prestashop product">
                <field name="backend_id" string="Backend"/>
                <field name="main_template_id"/>
                <field name="odoo_id" optional="show"/>
                <field name="quantity"/>
                <field name="prestashop_id"/>
                <field name="reference"/>
                <button name="manually_recompute_prestashop_qty" class="oe_highlight"
                        type="object" string="Export quantity"/>
                <button name="resync" type="object" string="Resync"/>
            </list>
        </field>
    </record>

    <record id="prestashop_product_template_action" model="ir.actions.act_window">
        <field name="name">Product (Template)</field>
        <field name="res_model">prestashop.product.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="prestashop_product_product_action" model="ir.actions.act_window">
        <field name="name">Combination (Variant)</field>
        <field name="res_model">prestashop.product.product</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
