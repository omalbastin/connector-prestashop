<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prestashop_product_category_search" model="ir.ui.view">
        <field name="name">prestashop.product.category.search</field>
        <field name="model">prestashop.product.category</field>
        <field name="arch" type="xml">
            <search string="Categories">
                <field name="prestashop_id"/>
                <field name="odoo_id"/>
                <field name="active_ext"/>
                <separator/>
                <filter
                        string="All"
                        name="all"
                        domain="['|', ('active_ext', '=', False), ('active_ext', '=', True)]"
                />
                <separator/>
                <filter
                        string="Archived"
                        name="inactive"
                        domain="[('active_ext', '=', False)]"
                />

            </search>
        </field>
    </record>

    <record id="product_category_connector_prestashop_tree_view"
            model="ir.ui.view">
        <field name="model">prestashop.product.category</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="(not active_ext)">
                <field name="backend_id" string="Backend"/>
                <field name="name"/>
                <!-- 				<field name="description"/> -->
                <field name="prestashop_id" readonly="1"/>
                <field name="odoo_id" readonly="1"/>
                <field name="date_add" invisible="1"/>
                <field name="date_upd"/>
                <field name="active_ext"/>
                <field name="default_shop_id"/>
                <button name="resync" type="object" string="Re-Import"/>
                <button name="re_export" type="object" string="Re-Export"/>

            </list>
        </field>
    </record>

    <record id="product_category_connector_prestashop_form_view"
            model="ir.ui.view">
        <field name="name">prestashop.product.category.form.view</field>
        <field name="model">prestashop.product.category</field>
        <field name="arch" type="xml">
            <form string="PrestaShop Product Category">
                <header>
                    <button name="resync" type="object" string="Re-Import"/>
                    <button name="re_export" type="object" string="Re-Export to PS"/>
                </header>
                <sheet>
                <group string="Primary Data">
                    <group>
                        <field name="name"/>
                        <field name="backend_id" string="Backend" readonly="1"/>
                            <field name="odoo_id" readonly="1"/>
                        <field name="prestashop_id" readonly="1"/>
                        <field name="default_shop_id"/>
                    </group>
                    <group>
                        <field name="date_add"/>
                        <field name="date_upd"/>
                        <field name="position"/>
                            <field name="active_ext"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="link_rewrite" required="1"/>
                        <field name="meta_description"/>
                    </group>
                    <group>
                        <field name="meta_keywords"/>
                        <field name="meta_title"/>
                    </group>
                </group>
                <group string="Descriptions">
                    <field name="description" placeholder="Description"/>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_category_prestashop_binding_form_view"
            model="ir.ui.view">
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[last()]" position="after">
                <notebook>

                    <page string="PrestaShop Binding" name="psbinding">
                        <field name="prestashop_bind_ids" nolabel="1"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="prestashop_product_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">prestashop.product.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_all': 1}</field>
    </record>

</odoo>
