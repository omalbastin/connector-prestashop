    <record id="view_prestashop_backend_form" model="ir.ui.view">
        <field name="name">prestashop.backend.form</field>
        <field name="model">prestashop.backend</field>
        <field name="arch" type="xml">
            <form string="PrestaShop Backend">
                <header>
                    <button
                            class="oe_highlight"
                            name="button_check_connection"
                            string="Check Connection"
                            type="object"
                            invisible="state != 'draft'"
                    />
                    <button
                            class="oe_highlight"
                            help="Synchonize shop and shop groups"
                            name="synchronize_metadata"
                            string="Synchronize Metadata"
                            type="object"
                            invisible="state == 'draft'"
                    />
                    <button
                            class="oe_highlight"
                            help="Synchonize datas like language, country, currency, tax"
                            name="synchronize_basedata"
                            string="Synchronize Base Data"
                            type="object"
                            invisible="state == 'draft'"
                    />
                    <button
                            name="button_reset_to_draft"
                            type="object"
                            string="Reset To draft Connection"
                            invisible="state == 'draft'"
                    />
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget
                                bg_color="bg-danger"
                                invisible="active == True"
                                name="web_ribbon"
                                text="Archived"
                        />
                        <field invisible="1" name="active"/>

                    </div>
                    <h1>
                        <field name="name" class="oe_inline"/>
                    </h1>
                    <group>
                        <group>
                            <field name="location"/>
                            <field name="webservice_key"/>
                            <field name="version"/>
                            <field name="verbose"/>
                            <field name="debug"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="default_language"/>
                            <field name="tz"/>
                            <field name="so_prefix_code"/>
                            <field name="export_active" string="Export to PS?"/>
                            <field name="auto_update_stock"/>
                            <field name="product_merge_based_on"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Main Configuration">
                            <group name="main_configuration">
                                <group>
                                    <!--                 				<field name="default_shop_id"/> -->
                                    <field
                                            name="pricelist_id"
                                            groups="product.group_product_pricelist"
                                            options="{'no_open':True,'no_create': True}"
                                    />
                                    <field name="discount_product_id"/>
                                    <field name="shipping_product_id"/>
                                    <field name="use_dummy_product"/>
                                    <field
                                            invisible="use_dummy_product == False"
                                            name="dummy_product_id"
                                            required="use_dummy_product == True"
                                    />
                                </group>
                                <group>
                                    <field name="warehouse_id"
                                           options="{'no_create': True}"/>
                                    <field name="stock_location_id"
                                           options="{'no_create': True}"/>
                                    <field name="refund_journal_id"/>
                                    <field name="sale_team_id"/>
                                    <field name="taxes_included"/>

                                </group>
                                <group string="Importable Order States">
                                    <field name="importable_order_state_ids"
                                           widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        <page name="import" string="Imports">
                            <p class="oe_grey oe_inline">
                                By clicking on the buttons,
                                you will initiate the synchronizations
                                with PrestaShop.
                                Note that the import or exports
                                won't be done directly,
                                they will create 'Jobs'
                                executed as soon as possible.
                            </p>
                            <p class="oe_grey oe_inline">
                                Once imported,
                                some types of records,
                                like the products or categories,
                                need a manual review.
                                You will find the list
                                of the new records to review
                                in the menu 'Connectors > Checkpoint'.
                            </p>
                            <group>
                                <group name="import_customer">
                                    <span class="o_form_label o_td_label" name="import_partners_since">
                                        <b>Import customer groups and customers since</b>
                                    </span>
                                    <div>
                                        <field name="import_partners_since"/>
                                        <button name="import_customers_since"
                                                type="object"
                                                class="oe_highlight oe_right"
                                                string="Import in background"/>
                                    </div>
                                </group>
                                <group name="import_suppliers">
                                    <span class="o_form_label o_td_label" name="import_suppliers_since">
                                        <b>Import suppliers since</b>
                                    </span>
                                    <div>
                                        <field name="import_suppliers_since"/>
                                        <button name="import_suppliers"
                                                type="object"
                                                class="oe_highlight oe_right"
                                                string="Import in background"/>
                                    </div>
                                </group>
                                <group name="import_carriers">
                                    <span class="o_form_label o_td_label" name="import_carriers">
                                        <b>Import carriers</b>
                                    </span>
                                    <div>
                                        <button name="import_carriers"
                                                type="object"
                                                class="oe_highlight"
                                                string="Import in background"/>
                                    </div>
                                </group>
                                <group name="import_products">
                                    <span class="o_form_label o_td_label" name="import_products_since">
                                        <b>Import product categories and products since</b>
                                    </span>
                                    <div>
                                        <field name="import_products_since"/>
                                        <button name="import_products"
                                                type="object"
                                                class="oe_highlight oe_right"
                                                string="Import in background"/>
                                    </div>
                                </group>

                                <group name="import_orders">
                                    <span class="o_form_label o_td_label" name="import_orders_since">
                                        <b>Import Orders since</b>
                                    </span>
                                    <div>
                                        <field name="import_orders_since"/>
                                        <button name="import_sale_orders"
                                                type="object"
                                                class="oe_highlight oe_right"
                                                string="Import in background"/>
                                    </div>
                                </group>
                                <group name="import_payment">
                                    <span class="o_form_label o_td_label" name="import_payment_mode_since">
                                        <b>Import Payment Mode since</b>
                                    </span>
                                    <div>
                                        <field name="import_payment_mode_since"/>
                                        <button name="import_payment_modes"
                                                type="object"
                                                class="oe_highlight oe_right"
                                                string="Import in background"/>
                                    </div>
                                </group>

                                <group name="import_refunds">
                                    <span class="o_form_label o_td_label" name="import_refunds_since">
                                        <b>Import refunds since</b>
                                    </span>
                                    <div>
                                        <field name="import_refunds_since"/>
                                        <button name="import_refunds"
                                                type="object"
                                                class="oe_highlight oe_right"
                                                string="Import in background"/>
                                    </div>
                                </group>
                                <group>
                                    <span class="o_form_label o_td_label" name="specific_model_name">
                                        <b>Import Specific record</b>
                                    </span>
                                    <div>
                                        <field name="specific_model_name"/>
                                        <field name="specific_record_id" placeholder="keep empty to import all records"
                                               class="oe_inline"/>
                                        <button name="import_specific_record" type="object"
                                                class="oe_highlight oe_right"
                                                string="Import in background"/>
                                    </div>

                                </group>
                                <group name="update_product_stock_qty">
                                    <span class="o_form_label o_td_label" name="update_product_stock_qty">
                                        <b>Export stock quantities</b>
                                    </span>
                                    <div>
                                        <button name="update_product_stock_qty"
                                                type="object" context="{'manual_update':True}"
                                                class="oe_highlight oe_right"
                                                string="Export Stock in background"/>
                                    </div>
                                </group>
                                <group name="import_stock_qty">
                                    <span class="o_form_label o_td_label" name="import_stock_qty">
                                        <b>Import stock quantities</b>
                                    </span>
                                    <div>
                                        <button name="import_stock_qty"
                                                type="object"
                                                class="oe_highlight oe_right"
                                                string="Import in background"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page name="export" string="Exports">
                            <group>
<!--                                <button name="export_all_products" type="object"-->
<!--                                        class="oe_highlight"-->
<!--                                        string="Export Products"/>-->

                                <!--                        <button name="export_all_categs" type="object"-->
                                <!--                             			class="oe_highlight"-->
                                <!--                                        string="Export Categories"/>-->
                            </group>
                        </page>
                        <page string="Languages">
                            <field name="language_ids" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="active"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="active" readonly="1"/>
                                        <field name="code" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="prestashop_id" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_prestashop_backend_tree" model="ir.ui.view">
        <field name="name">prestashop.backend.list</field>
        <field name="model">prestashop.backend</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="location"/>
            </list>
        </field>
    </record>

    <record id="action_prestashop_backend" model="ir.actions.act_window">
        <field name="name">PrestaShop Backends</field>
        <field name="res_model">prestashop.backend</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="view_prestashop_shop_group_form" model="ir.ui.view">
        <field name="name">prestashop.shop.group.form</field>
        <field name="model">prestashop.shop.group</field>
        <field name="arch" type="xml">
            <form string="PrestaShop Shop Group">
                <h1>
                    <field name="name" class="oe_inline"/>
                </h1>
                <group>
                    <field name="backend_id"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_prestashop_shop_group_tree" model="ir.ui.view">
        <field name="name">prestashop.shop.group.list</field>
        <field name="model">prestashop.shop.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="backend_id"/>
            </list>
        </field>
    </record>

    <record id="action_prestashop_shop_group" model="ir.actions.act_window">
        <field name="name">PrestaShop Shop Groups</field>
        <field name="res_model">prestashop.shop.group</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="view_prestashop_shop_form" model="ir.ui.view">
        <field name="name">prestashop.shop.form</field>
        <field name="model">prestashop.shop</field>
        <field name="arch" type="xml">
            <form string="PrestaShop Shop">
                <sheet>
                    <h1>
                        <field name="name" class="oe_inline"/>
                    </h1>
                    <group>
                        <group>
                            <field name="shop_group_id"/>
                            <field name="odoo_id"/>
                            <field name="backend_id"/>

                        </group>
                        <group>
                            <field name="prestashop_id"/>
                            <field name="default_url"/>
                        </group>
                    </group>
                    <!--                 <notebook> -->
                    <!--                 	<page string="Categories"> -->
                    <!--                 		<field name="prestashop_category_ids"/> -->
                    <!--                 	</page> -->
                    <!--                 </notebook> -->
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_prestashop_shop_tree" model="ir.ui.view">
        <field name="name">prestashop.shop.list</field>
        <field name="model">prestashop.shop</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="shop_group_id"/>
                <field name="odoo_id"/>
            </list>
        </field>
    </record>

    <record id="action_prestashop_shop" model="ir.actions.act_window">
        <field name="name">PrestaShop Shops</field>
        <field name="res_model">prestashop.shop</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
