<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="sync_products_form">
        <field name="name">sync.products.form</field>
        <field name="model">sync.products</field>
        <field name="arch" type="xml">
            <form string="Import/Export Products">
                <separator string="Sync Selected Products"/>
                <footer>
                    <button name="sync_products" type="object"
                            string="Re-Import" class="oe_highlight"/>
                    or
                    <button name="re_export_products" type="object"
                            string="Re-Export" class="oe_highlight"/>
                    or
                    <button string="Cancel" class="oe_link"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="act_presta_sync_products" model="ir.actions.act_window">
        <field name="name">Sync Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="res_model">sync.products</field>
        <field name="target">new</field>
        <!--        <field name="search_view_id" ref="product_category_search_view"/>-->
    </record>

</odoo>
