<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record forcecreate="True" id="ir_cron_scheduler_deactivate_default_product" model="ir.cron">
        <field name="name">PrestaShop - Deactivate Default Product</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="state">code</field>
        <field name="code">model.scheduler_deactivate_default_product()</field>
        <field name="model_id" ref="product.model_product_template"/>
    </record>

